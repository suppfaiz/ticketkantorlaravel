APP_NAME="NALA IT Helpdesk"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://helpdesk.domainkantor.com
FORCE_HTTPS=true

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Konfigurasi Database MySQL / MariaDB di cPanel
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_ticketlaravel
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=password_database_cpanel
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=nala_helpdesk_

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.domainkantor.com
MAIL_PORT=465
MAIL_USERNAME=helpdesk@domainkantor.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="helpdesk@domainkantor.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Akun Admin Pertama saat menjalankan `php artisan db:seed --force`
INITIAL_ADMIN_EMAIL=admin@kantor.internal
INITIAL_ADMIN_PASSWORD="GantiDenganPasswordKuatDanUnik"

# SSO Configuration
SSO_DRIVER=local
SSO_API_URL=https://sso.kantor.com/api/v1
SSO_CLIENT_ID=it-helpdesk-client
SSO_CLIENT_SECRET=
SSO_JWT_PUBLIC_KEY=
SSO_JWT_ALGORITHM=RS256
SSO_JWT_ISSUER=
SSO_JWT_AUDIENCE=

# LOA API Configuration
LOA_DRIVER=local
LOA_API_URL=https://loa.kantor.com/api/v1
LOA_API_KEY=
LOA_WEBHOOK_SECRET=
LOA_MOCK_AUTO_APPROVE=false

# Realtime Configuration (polling disarankan untuk cPanel)
REALTIME_DRIVER=polling
REALTIME_POLL_INTERVAL_MS=5000
WEBSOCKET_URL=
