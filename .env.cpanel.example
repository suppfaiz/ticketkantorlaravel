APP_NAME="NALA Helpdesk IT"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://helpdesk.domainkantor.com
FORCE_HTTPS=true

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Konfigurasi Database MySQL / MariaDB di cPanel
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_ticketlaravel
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=password_database_cpanel

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=smtp
MAIL_HOST=mail.domainkantor.com
MAIL_PORT=465
MAIL_USERNAME=helpdesk@domainkantor.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="helpdesk@domainkantor.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# SSO Configuration
SSO_DRIVER=mock
SSO_API_URL=https://sso.kantor.com/api/v1
SSO_CLIENT_ID=it-helpdesk-client
SSO_CLIENT_SECRET=
SSO_JWT_PUBLIC_KEY=

# LOA API Configuration
LOA_DRIVER=mock
LOA_API_URL=https://loa.kantor.com/api/v1
LOA_API_KEY=
LOA_WEBHOOK_SECRET=
LOA_MOCK_AUTO_APPROVE=false
