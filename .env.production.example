APP_NAME="NALA IT Helpdesk"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://helpdesk.perusahaan-anda.com
FORCE_HTTPS=true

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_ticketdb
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD="GantiPasswordDatabaseAnda"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=nala_helpdesk_

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.perusahaan-anda.com
MAIL_PORT=465
MAIL_USERNAME=helpdesk@perusahaan-anda.com
MAIL_PASSWORD="GantiPasswordEmailAnda"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="helpdesk@perusahaan-anda.com"
MAIL_FROM_NAME="${APP_NAME}"

# Akun Admin Pertama saat menjalankan `php artisan db:seed --force` di Production
INITIAL_ADMIN_EMAIL=admin@kantor.internal
INITIAL_ADMIN_PASSWORD="GantiDenganPasswordKuatDanUnik"

# SSO Configuration
SSO_DRIVER=local
SSO_API_URL=https://sso.kantor.com/api/v1
SSO_CLIENT_ID=it-helpdesk-client
SSO_CLIENT_SECRET=
SSO_JWT_PUBLIC_KEY=
SSO_JWT_ALGORITHM=RS256
SSO_JWT_ISSUER=
SSO_JWT_AUDIENCE=

# LOA API Configuration
LOA_DRIVER=local
LOA_API_URL=https://loa.kantor.com/api/v1
LOA_API_KEY=
LOA_WEBHOOK_SECRET=
LOA_MOCK_AUTO_APPROVE=false

# Realtime Configuration (polling disarankan untuk cPanel)
REALTIME_DRIVER=polling
REALTIME_POLL_INTERVAL_MS=5000
WEBSOCKET_URL=
